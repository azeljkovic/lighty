{
  "name": "lighty",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node --eval \"import('node:fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\"",
    "build": "npm run clean && tsc",
    "prepack": "npm run build",
    "lint": "pnpm exec prettier . --write",
    "run": "pnpm run build && VERBOSE_LOGGING=true node run.ts",
    "test": "pnpm run build && node --test test/unit.test.js",
    "test:e2e": "pnpm run build && node --test test/e2e.test.js",
    "test:e2e:verbose": "pnpm run build && VERBOSE_LOGGING=true node --test test/e2e.test.js"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "prettier": "3.8.3",
    "typescript": "6.0.3"
  }
}
