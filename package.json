{
  "name": "@azeljkovic/lighty",
  "version": "0.0.1",
  "type": "module",
  "license": "MIT",
  "description": "Lightweight HTTP client and testing library.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azeljkovic/lighty.git"
  },
  "homepage": "https://lighty.dev",
  "bugs": {
    "url": "https://github.com/azeljkovic/lighty/issues",
    "email": "dev@zeljkovic.com"
  },
  "keywords": [
    "http",
    "testing",
    "api-testing",
    "integration-testing",
    "fetch",
    "node",
    "node-test",
    "typescript",
    "esm",
    "request",
    "assertions",
    "test-utils",
    "http-client",
    "rest",
    "json"
  ],
  "author": "Aleksandar Zeljkovic <dev@zeljkovic.com> (https://www.zeljkovic.com)",
  "packageManager": "pnpm@11.10.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node --eval \"import('node:fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\"",
    "build": "pnpm run clean && tsc",
    "prepack": "pnpm run build",
    "format": "pnpm exec prettier . --write",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm run build && node --test test/unit/*.test.js test/integration/*.test.js",
    "test:unit": "pnpm run build && node --test test/unit/*.test.js",
    "test:integration": "pnpm run build && node --test test/integration/*.test.js",
    "test:examples-all": "pnpm run build && node --test examples/*.test.js",
    "test:package": "node --test test/package-smoke.test.js",
    "test:examples": "pnpm run build && node --test examples/*.test.js"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.0",
    "@commitlint/config-conventional": "21.2.0",
    "@eslint/js": "10.0.1",
    "@eslint/json": "1.2.0",
    "@eslint/markdown": "8.0.2",
    "@types/node": "25.9.1",
    "eslint": "10.4.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.6.0",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "prettier": "3.8.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.0"
  },
  "engines": {
    "node": ">=24"
  }
}
